<?xml version="1.0" encoding="UTF-8"?>
<!-- 测试专用：只输出控制台，不写 logs/seat-exam.log，避免 mvn test 覆盖已提交的日志样例 -->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level [%t] %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="org.optaplanner" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Root level="warn"/>
    </Loggers>
</Configuration>
